# Public browser Maps key only; restrict HTTP referrers and allowed APIs in Google Cloud.
PUBLIC_GOOGLE_MAPS_KEY=
# Final public URL, including a project subpath if applicable.
SITE_URL=https://wer134.github.io/HowdoIgetthere/
PORT=8080
# Local AI keys must be supplied through your environment, never this example or a build.

# Optional account server. Empty credentials keep all account APIs disabled.
# HTTPS origin only, no path/trailing slash. HTTP is allowed on loopback for development.
ACCOUNT_ORIGIN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# At least 32 random bytes, backed up with the database. Never rotate without migration.
ACCOUNT_SECRET=
ACCOUNT_DB_PATH=data/accounts.sqlite
# Exact socket peer addresses of reverse proxies you control; empty ignores forwarded IPs.
TRUSTED_PROXY_ADDRESSES=
ACCOUNT_MAX_USERS=10000
ACCOUNT_MAX_TOTAL_BYTES=1073741824
ACCOUNT_MAX_SUGGESTIONS=100000

# Optional SMS / operator-funded AI. Every budget is integer micro-USD (1 USD = 1000000).
# Zero limits disable external calls. Set a conservative maximum per call including fees.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMS_ALLOWED_COUNTRIES=KR
SMS_DAILY_CALL_LIMIT=0
SMS_MONTHLY_CALL_LIMIT=0
SMS_DAILY_BUDGET_MICROUSD=0
SMS_MONTHLY_BUDGET_MICROUSD=0
SMS_MAX_COST_MICROUSD=0
FREE_AI_ENABLED=false
SERVICE_GEMINI_API_KEY=
SERVICE_GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_CALL_LIMIT=0
AI_MONTHLY_CALL_LIMIT=0
AI_DAILY_BUDGET_MICROUSD=0
AI_MONTHLY_BUDGET_MICROUSD=0
AI_MAX_COST_MICROUSD=0
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=2048
